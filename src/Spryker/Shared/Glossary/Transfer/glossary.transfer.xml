<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="Translation">
        <property name="idGlossaryTranslation" type="int"/>
        <property name="fkGlossaryKey" type="int"/>
        <property name="fkLocale" type="int"/>
        <property name="value" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="glossaryKey" type="GlossaryKey" strict="true"/>
    </transfer>

    <transfer name="KeyTranslation">
        <property name="glossaryKey" type="int"/>
        <property name="locales" type="array" singular="locales"/>
    </transfer>

    <transfer name="Locale">
        <property name="localeName" type="string"/>
        <property name="idLocale" type="int"/>
    </transfer>

    <transfer name="Message">
        <property name="value" type="string"/>
    </transfer>

    <transfer name="GlossaryKey">
        <property name="idGlossaryKey" type="int"/>
        <property name="isActive" type="bool"/>
        <property name="key" type="string"/>
        <property name="translations" type="Translation[]" singular="translation" strict="true"/>
    </transfer>

    <transfer name="GlossaryKeyCriteria" strict="true">
        <property name="glossaryKeyConditions" type="GlossaryKeyConditions"/>
        <property name="sortCollection" type="Sort[]" singular="sort"/>
        <property name="pagination" type="Pagination"/>
    </transfer>

    <transfer name="GlossaryKeyConditions" strict="true">
        <property name="keys" type="string[]" singular="key"/>
        <property name="keyFragment" type="string"/>
        <property name="translationValueFragment" type="string"/>
    </transfer>

    <transfer name="GlossaryKeyCollection" strict="true">
        <property name="glossaryKeys" type="GlossaryKey[]" singular="glossaryKey"/>
        <property name="pagination" type="Pagination"/>
    </transfer>

    <transfer name="Sort">
        <property name="field" type="string"/>
        <property name="isAscending" type="bool"/>
    </transfer>

    <transfer name="Pagination">
        <property name="limit" type="int"/>
        <property name="offset" type="int"/>
        <property name="nbResults" type="int"/>
    </transfer>

    <transfer name="AclEntityMetadataConfig">
        <property name="aclEntityMetadataCollection" type="AclEntityMetadataCollection"/>
    </transfer>

    <transfer name="AclEntityMetadata">
        <property name="entityName" type="string"/>
        <property name="isSubEntity" type="bool"/>
        <property name="defaultGlobalOperationMask" type="int"/>
        <property name="parent" type="AclEntityParentMetadata"/>
    </transfer>

    <transfer name="AclEntityParentMetadata">
        <property name="entityName" type="string"/>
    </transfer>

    <transfer name="AclEntityMetadataCollection">
        <property name="collection" type="array" singular="aclEntityMetadata" associative="true"/>
    </transfer>

</transfers>
